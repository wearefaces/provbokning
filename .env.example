# Copy to .env and fill in. docker compose will load this automatically.

# Port exposed on the host (container always listens on 8080 internally)
HOST_PORT=8080

# Web login (required to access the UI)
LOGIN_USER=admin
LOGIN_PASS=change-me

# Flask session signing key. Generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=

# Set to 1 only when serving over HTTPS (e.g. behind a reverse proxy)
COOKIE_SECURE=0

# Optional: 46elks SMS notifications
SMS_API_USERNAME=
SMS_API_PASSWORD=

# App Store review login. Set to a secret code, then give it to Apple in
# App Store Connect → App Review Information. A reviewer long-presses the
# BOKAPROV wordmark on the login screen and enters this code to explore the
# app with sample data (no BankID, no Trafikverket access, no real bookings).
# Leave empty to disable the demo login entirely.
REVIEW_DEMO_CODE=
