# ---- Server ----
PORT=3000
# Public base URL of this app (used to build the LinkedIn OAuth redirect URI).
# Locally this is usually http://localhost:3000
BASE_URL=http://localhost:3000
# Password to access the web UI. If unset, the UI is OPEN (fine for localhost,
# NOT fine once deployed). Set a long random string in production.
APP_PASSWORD=
# Secret used to sign the login session cookie. Set any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Anthropic (Claude) ----
# Used to generate post ideas and drafts.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8.
CLAUDE_MODEL=claude-opus-4-8

# ---- LinkedIn OAuth ----
# Create an app at https://www.linkedin.com/developers/apps
# Request the "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn" products.
# Add  <BASE_URL>/auth/linkedin/callback  as an authorized redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Scopes. openid+profile identify you; w_member_social is required to publish.
LINKEDIN_SCOPES=openid profile w_member_social
# LinkedIn versioned APIs header (YYYYMM). Bump occasionally.
LINKEDIN_API_VERSION=202405

# ---- Pipeline ----
# Cron schedule for the automatic draft-generation run (server local time).
# Default: every day at 08:00.
GENERATE_CRON=0 8 * * *
# Max number of drafts to create per pipeline run.
MAX_DRAFTS_PER_RUN=3
# How many fresh LLM-generated topic ideas to consider each run.
LLM_IDEAS_PER_RUN=4
